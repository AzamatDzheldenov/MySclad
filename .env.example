# ============================================================================
# Конфигурация окружения проекта «МойСклад» для VPS (Docker Compose)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ============================================================================

# --- Порт веб-сервера Nginx на хосте ---
HTTP_PORT=80

# --- Настройки PostgreSQL ---
POSTGRES_USER=moysklad_user
POSTGRES_PASSWORD=change_me_strong_db_password_2026
POSTGRES_DB=moysklad

# Полный DSN (формируется автоматически в docker-compose.yml, используется при локальном запуске)
DATABASE_URL=postgresql+asyncpg://moysklad_user:change_me_strong_db_password_2026@db:5432/moysklad

# --- Директория сохранения фотографий подписанных накладных ---
WAYBILL_UPLOAD_DIR=/app/uploads/waybills

# --- Настройки Telegram-бота (получите токен у @BotFather) ---
TELEGRAM_BOT_TOKEN=1234567890:AAF_your_telegram_bot_token_here

# Внутренний адрес API для контейнера бота
API_BASE_URL=http://backend:8000/api

